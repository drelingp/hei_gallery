# --- App ---
NODE_ENV=development
PORT=6765
# Public base URL (used for absolute links, OG images). Change for production.
NEXT_PUBLIC_SITE_URL=http://localhost:6765
SITE_NAME="Hei Gallery"

# --- Database (SQLite, single file, no server required) ---
# Default works for local + most hosts. For Docker/Postgres see README.
DATABASE_URL=file:../data/hei.db

# --- Session / Auth ---
# Generate a strong random value: `openssl rand -base64 48`
SESSION_PASSWORD=please-change-me-to-a-long-random-string-of-at-least-32-chars

# --- Uploads ---
# Relative to the app folder. Backup = zip this folder.
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=25

# --- Optional PayPal bridge (links only, no automated checkout at launch) ---
# Leave blank to hide PayPal fields in admin.
PAYPAL_BUSINESS_EMAIL=
