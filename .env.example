# --- App ---
NODE_ENV=development
PORT=6765
# Public base URL (absolute links, OG images). Required in production.
NEXT_PUBLIC_SITE_URL=http://localhost:6765
SITE_NAME="Hei Gallery"

# --- Database (Neon Postgres) ---
# Runtime: pooled connection. The hostname contains `-pooler`.
# The app adds pgbouncer=true and connection_limit=1 for Neon pooler hosts.
# postgresql://USER:PASSWORD@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require

# Migrations (`npm run prisma:deploy`): direct connection, no `-pooler`.
# Neon and the Vercel integration expose this as DATABASE_URL_UNPOOLED.
# Local Postgres (Docker) can set both variables to the same URL.
# postgresql://USER:PASSWORD@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-example.region.aws.neon.tech/neondb?sslmode=require

# --- Session / Auth ---
# Generate a strong random value: `openssl rand -base64 48`
# Required in production, at least 32 characters.
SESSION_PASSWORD=please-change-me-to-a-long-random-string-of-at-least-32-chars

# --- Cloudflare R2 (S3-compatible object storage) ---
# Create an R2 API token with Object Read & Write on the bucket.
# R2_PUBLIC_URL is the public base for objects (r2.dev subdomain or custom domain), no trailing path.
# Bucket CORS must allow GET, HEAD, and PUT from NEXT_PUBLIC_SITE_URL. See README.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=hei-gallery
R2_PUBLIC_URL=https://pub-example.r2.dev

# Max upload size in megabytes (images and GLB). Files over 4 MB upload directly to R2.
MAX_UPLOAD_MB=25

# --- Optional PayPal bridge (links only, no automated checkout at launch) ---
# Leave blank to hide PayPal fields in admin.
PAYPAL_BUSINESS_EMAIL=
